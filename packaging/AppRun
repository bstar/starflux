#!/bin/sh
set -eu
umask 077
HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# Controllers and PTY brokers survive the frontend. Run from a durable private
# cache, never from the temporary AppImage FUSE mount/extraction directory.
BUILD=@BUILD@
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/starflux/appimage
DEST=$CACHE/$BUILD
if [ "$HERE" != "$DEST" ]; then
    mkdir -p "$CACHE"
    if [ ! -f "$DEST/.complete" ]; then
        STAGE=$(mktemp -d "$CACHE/.stage-XXXXXXXX")
        trap 'rm -rf "$STAGE"' EXIT HUP INT TERM
        cp -a "$HERE/." "$STAGE/"
        touch "$STAGE/.complete"
        # Atomic publication; another frontend may have populated this build.
        if ! mv -T "$STAGE" "$DEST" 2>/dev/null; then
            test -f "$DEST/.complete"
            rm -rf "$STAGE"
        fi
        trap - EXIT HUP INT TERM
    fi
    exec "$DEST/AppRun" "$@"
fi
export STARFLUX_SYSTEM_PATH="${STARFLUX_SYSTEM_PATH:-$PATH}"
export PATH="$HERE/usr/bin:$STARFLUX_SYSTEM_PATH"
export TERMINFO_DIRS="$HERE/usr/share/terminfo${TERMINFO_DIRS:+:$TERMINFO_DIRS}:/usr/share/terminfo:/lib/terminfo"
export GST_PLUGIN_SYSTEM_PATH_1_0="$HERE/usr/lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER="$HERE/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
export GST_REGISTRY="${XDG_CACHE_HOME:-$HOME/.cache}/starflux/gst-$BUILD.bin"
export ALSA_CONFIG_DIR="$HERE/usr/share/alsa"
export ALSA_CONFIG_PATH="$HERE/usr/share/alsa/alsa.conf"
export ALSA_PLUGIN_DIR="$HERE/usr/lib/alsa-lib"
unset APPDIR
# A safe headless diagnostic of the actual bundled tools and codec plugins.
if [ "${1-}" = --check-bundle ]; then
    starflux --version
    starflux-terminal-client --help
    starflux-pty-proxy --help
    python3 -c 'import ctypes, fcntl, hashlib, json, socket, ssl, termios; print("Bundled Python ready")'
    tmux -V
    # Private fake terminal only: no GUI and no existing workspace/server.
    PROOF=starflux-bundle-proof-$$
    trap 'tmux -L "$PROOF" kill-server 2>/dev/null || true' EXIT HUP INT TERM
    tmux -L "$PROOF" -f /dev/null new-session -d -s proof 'sleep 10'
    tmux -L "$PROOF" set-option -g allow-passthrough on
    tmux -L "$PROOF" set-option -g extended-keys on
    tmux -L "$PROOF" kill-server
    trap - EXIT HUP INT TERM
    dbus-run-session -- python3 -c 'import os; assert os.environ.get("DBUS_SESSION_BUS_ADDRESS"); print("Private D-Bus ready")'
    pactl --version
    parec --version
    gst-inspect-1.0 x264enc >/dev/null
    gst-inspect-1.0 appsrc >/dev/null
    gst-inspect-1.0 appsink >/dev/null
    gst-launch-1.0 -q videotestsrc num-buffers=2 ! video/x-raw,width=64,height=64,framerate=60/1 ! videoconvert ! x264enc tune=zerolatency ! fakesink
    exec starflux --themes
fi
exec "$HERE/usr/bin/starflux" "$@"
