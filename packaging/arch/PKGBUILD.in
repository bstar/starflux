# Generated from the exact release checkout by scripts/dist/arch.sh.
pkgname=starmux
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native Kitty terminals, agents and persistent local/SSH app desktops'
arch=('x86_64')
url='https://github.com/bstar/starmux'
license=('MIT')
depends=('glibc' 'gcc-libs' 'ffmpeg' 'alsa-lib' 'alsa-plugins' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav' 'glib2' 'wayland' 'libxkbcommon' 'libdrm' 'mesa' 'libglvnd' 'libpulse' 'tmux' 'python' 'openssh' 'xorg-xwayland' 'dbus' 'kitty')
makedepends=('rust>=1.98' 'git' 'clang' 'pkgconf')
options=('!lto' '!debug')
source=("starmux-${pkgver}.tar.gz")
sha256sums=('@SHA256@')
_cargo_env() {
    export CARGO_HOME="${ARCH_CARGO_HOME:-$srcdir/cargo}"
    export CARGO_TARGET_DIR="$srcdir/target"
    export CARGO_NET_GIT_FETCH_WITH_CLI=true
}
prepare() {
    cd "$srcdir/starmux-$pkgver"
    _cargo_env
    cargo fetch --locked
}
build() {
    cd "$srcdir/starmux-$pkgver"
    _cargo_env
    cargo build --workspace --release --frozen
    cc -std=c11 -O2 -Wall -Wextra -Werror native/pty-proxy.c -o "$CARGO_TARGET_DIR/release/starmux-pty-proxy"
}
check() {
    cd "$srcdir/starmux-$pkgver"
    _cargo_env
    cargo test --workspace --release --frozen --all-features
}
package() {
    cd "$srcdir/starmux-$pkgver"
    for executable in starmux starmux-terminal-client starmux-pty-proxy; do
        install -Dm755 "$srcdir/target/release/$executable" "$pkgdir/usr/bin/$executable"
    done
    install -Dm644 packaging/starmux.desktop "$pkgdir/usr/share/applications/starmux.desktop"
    install -Dm644 packaging/starmux.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/starmux.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/starmux/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/starmux/README.md"
    cp -R docs "$pkgdir/usr/share/doc/starmux/"
}
