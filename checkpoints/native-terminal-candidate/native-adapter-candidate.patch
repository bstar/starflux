diff --git a/src/graphics_delivery.rs b/src/graphics_delivery.rs
new file mode 100644
--- /dev/null
+++ b/src/graphics_delivery.rs
@@ -0,0 +1,189 @@
+//! Latest-per-view local image delivery. Media/control forwarding never waits
+//! for PNG presentation; queues retain at most 16 MiB and 64 view identities.
+use anyhow::{Context, Result, ensure};
+use serde_json::Value;
+use std::{
+    collections::{BTreeMap, VecDeque},
+    io::{Read, Write},
+    os::unix::net::UnixStream,
+    sync::{Arc, Condvar, Mutex},
+    time::Duration,
+};
+struct Pending {
+    values: BTreeMap<String, (Value, usize)>,
+    order: VecDeque<String>,
+    bytes: usize,
+    stopped: bool,
+    error: Option<String>,
+}
+impl Pending {
+    fn new() -> Self {
+        Self {
+            values: BTreeMap::new(),
+            order: VecDeque::new(),
+            bytes: 0,
+            stopped: false,
+            error: None,
+        }
+    }
+    fn submit(&mut self, value: Value) -> Result<()> {
+        ensure!(!self.stopped, "Native image delivery stopped");
+        let view = value["view"]
+            .as_str()
+            .context("Missing native image view")?
+            .to_owned();
+        ensure!(
+            !view.is_empty()
+                && view.len() <= 96
+                && view
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"_-".contains(&b)),
+            "Invalid native image view"
+        );
+        ensure!(
+            value["op"] == "planes" || value["op"] == "clear",
+            "Invalid native image operation"
+        );
+        let charge = serde_json::to_vec(&value)?.len();
+        ensure!(
+            charge <= 4 * 1024 * 1024,
+            "Native image request exceeds limit"
+        );
+        let previous = self.values.get(&view).map_or(0, |(_, n)| *n);
+        ensure!(
+            self.bytes - previous + charge <= 16 * 1024 * 1024,
+            "Native image delivery queue is busy"
+        );
+        ensure!(
+            self.values.contains_key(&view) || self.values.len() < 64,
+            "Too many queued image views"
+        );
+        if previous == 0 {
+            self.order.push_back(view.clone());
+        }
+        self.bytes = self.bytes - previous + charge;
+        self.values.insert(view, (value, charge));
+        Ok(())
+    }
+    fn take(&mut self) -> Option<Value> {
+        let view = self.order.pop_front()?;
+        let (value, charge) = self.values.remove(&view)?;
+        self.bytes -= charge;
+        Some(value)
+    }
+}
+pub struct Delivery {
+    state: Arc<(Mutex<Pending>, Condvar)>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+impl Delivery {
+    pub fn new(upstream: &Arc<Mutex<UnixStream>>) -> Result<Self> {
+        let shutdown = upstream.lock().unwrap().try_clone()?;
+        let state = Arc::new((Mutex::new(Pending::new()), Condvar::new()));
+        let worker = state.clone();
+        let thread = std::thread::spawn(move || {
+            loop {
+                let request = {
+                    let (lock, wake) = &*worker;
+                    let mut state = lock.lock().unwrap();
+                    while state.values.is_empty() && !state.stopped {
+                        state = wake.wait(state).unwrap();
+                    }
+                    if state.stopped {
+                        return;
+                    }
+                    state.take().unwrap()
+                };
+                let result = (|| -> Result<()> {
+                    let path = std::env::var_os("STARFLUX_FONT_OUTPUT")
+                        .context("Local image output is unavailable")?;
+                    let mut output = UnixStream::connect(path)?;
+                    output.set_read_timeout(Some(Duration::from_secs(3)))?;
+                    output.set_write_timeout(Some(Duration::from_secs(3)))?;
+                    serde_json::to_writer(&mut output, &request)?;
+                    output.write_all(b"\n")?;
+                    let mut accepted = [0];
+                    output.read_exact(&mut accepted)?;
+                    ensure!(
+                        accepted[0] == 1,
+                        "Local native image presenter rejected the frame"
+                    );
+                    Ok(())
+                })();
+                if let Err(error) = result {
+                    let mut state = worker.0.lock().unwrap();
+                    state.error = Some(format!("{error:#}"));
+                    state.stopped = true;
+                    state.values.clear();
+                    state.order.clear();
+                    state.bytes = 0;
+                    let _ = shutdown.shutdown(std::net::Shutdown::Both);
+                    return;
+                }
+            }
+        });
+        Ok(Self {
+            state,
+            thread: Some(thread),
+        })
+    }
+    pub fn submit(&self, request: Value) -> Result<()> {
+        self.state.0.lock().unwrap().submit(request)?;
+        self.state.1.notify_one();
+        Ok(())
+    }
+    pub fn error(&self) -> Option<String> {
+        self.state.0.lock().unwrap().error.clone()
+    }
+}
+impl Drop for Delivery {
+    fn drop(&mut self) {
+        let mut state = self.state.0.lock().unwrap();
+        state.stopped = true;
+        state.values.clear();
+        state.order.clear();
+        state.bytes = 0;
+        drop(state);
+        self.state.1.notify_one();
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn replacing_a_view_keeps_latest_clear_and_does_not_starve_other_views() {
+        let mut state = Pending::new();
+        state
+            .submit(serde_json::json!({"op":"planes","view":"first","sequence":1}))
+            .unwrap();
+        state
+            .submit(serde_json::json!({"op":"planes","view":"second","sequence":1}))
+            .unwrap();
+        for sequence in 2..50 {
+            state
+                .submit(serde_json::json!({"op":"planes","view":"first","sequence":sequence}))
+                .unwrap();
+        }
+        state
+            .submit(serde_json::json!({"op":"clear","view":"first"}))
+            .unwrap();
+        assert_eq!(state.values.len(), 2);
+        assert_eq!(state.take().unwrap()["op"], "clear");
+        assert_eq!(state.take().unwrap()["view"], "second");
+        assert_eq!(state.bytes, 0);
+    }
+    #[test]
+    fn an_oversized_replacement_keeps_the_last_admitted_request() {
+        let mut state = Pending::new();
+        state
+            .submit(serde_json::json!({"op":"clear","view":"first"}))
+            .unwrap();
+        let bytes = state.bytes;
+        assert!(state.submit(serde_json::json!({"op":"planes","view":"first","payload":"x".repeat(4*1024*1024)})).is_err());
+        assert_eq!(state.bytes, bytes);
+        assert_eq!(state.take().unwrap()["op"], "clear");
+    }
+}
diff --git a/src/graphics_frontend.rs b/src/graphics_frontend.rs
new file mode 100644
--- /dev/null
+++ b/src/graphics_frontend.rs
@@ -0,0 +1,278 @@
+//! Display-side Kitty image planes. Only validated inline PNG bytes are accepted;
+//! no file, command, path, arbitrary escape, or caller-selected Kitty ID is used.
+use anyhow::{Context, Result, ensure};
+use base64::{Engine, engine::general_purpose::STANDARD};
+use serde_json::Value;
+use std::{collections::BTreeMap, io::Write};
+pub const META: &str = "starflux-image-planes-v1";
+struct Slot {
+    signature: String,
+    ids: Vec<u32>,
+    encoded: usize,
+    decoded: usize,
+}
+pub struct Presenter {
+    slots: BTreeMap<String, Slot>,
+    next: u32,
+    generation: u64,
+}
+impl Default for Presenter {
+    fn default() -> Self {
+        Self {
+            slots: BTreeMap::new(),
+            next: 0xe0000000,
+            generation: 0,
+        }
+    }
+}
+fn numbers<const N: usize>(value: &Value) -> Result<[u32; N]> {
+    let array = value.as_array().context("Missing native image geometry")?;
+    ensure!(array.len() == N, "Invalid native image geometry");
+    let mut result = [0; N];
+    for (a, b) in result.iter_mut().zip(array) {
+        *a = b
+            .as_u64()
+            .and_then(|n| n.try_into().ok())
+            .context("Invalid native image coordinate")?;
+    }
+    Ok(result)
+}
+fn retire(ids: &[u32], out: &mut impl Write) -> Result<()> {
+    for id in ids {
+        write!(out, "\x1b_Ga=d,d=I,i={id},q=2;\x1b\\")?;
+    }
+    Ok(())
+}
+impl Presenter {
+    pub fn clear(&mut self, out: &mut impl Write) -> Result<()> {
+        for slot in self.slots.values() {
+            retire(&slot.ids, out)?;
+        }
+        self.slots.clear();
+        out.flush()?;
+        Ok(())
+    }
+    pub fn apply(&mut self, value: &Value, out: &mut impl Write) -> Result<()> {
+        let view = value["view"]
+            .as_str()
+            .context("Missing native image view")?;
+        ensure!(
+            !view.is_empty()
+                && view.len() <= 96
+                && view
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"_-".contains(&b)),
+            "Invalid native image view"
+        );
+        if value["op"] == "clear" {
+            if let Some(old) = self.slots.remove(view) {
+                retire(&old.ids, out)?;
+                out.flush()?;
+            }
+            return Ok(());
+        }
+        ensure!(value["op"] == "planes", "Invalid native image operation");
+        let generation = value["generation"]
+            .as_u64()
+            .filter(|n| *n > 0)
+            .context("Invalid native image generation")?;
+        if generation < self.generation {
+            return Ok(());
+        }
+        let [x, y, columns, rows] = numbers::<4>(&value["rect"])?;
+        let [cw, ch] = numbers::<2>(&value["cell"])?;
+        ensure!(
+            columns > 0
+                && columns <= 512
+                && rows > 0
+                && rows <= 192
+                && x.checked_add(columns).is_some_and(|n| n <= 4096)
+                && y.checked_add(rows).is_some_and(|n| n <= 4096)
+                && (1..=256).contains(&cw)
+                && (1..=256).contains(&ch),
+            "Native image placement exceeds limit"
+        );
+        let planes = &value["planes"];
+        let width = planes["width"]
+            .as_u64()
+            .context("Missing native image width")?;
+        let height = planes["height"]
+            .as_u64()
+            .context("Missing native image height")?;
+        ensure!(
+            width == u64::from(columns * cw)
+                && height == u64::from(rows * ch)
+                && width * height <= 16 * 1024 * 1024,
+            "Native image dimensions disagree"
+        );
+        let mut images = Vec::new();
+        let mut encoded = 0;
+        let mut decoded = 0;
+        for (field, z) in [("below", -1), ("above", 1)] {
+            if planes[field].is_null() {
+                continue;
+            }
+            let png = planes[field].as_str().context("Invalid native plane")?;
+            ensure!(
+                png.len() <= 3 * 1024 * 1024,
+                "Native plane exceeds wire limit"
+            );
+            let bytes = STANDARD.decode(png)?;
+            let dimensions = starkit::image::ImageReader::with_format(
+                std::io::Cursor::new(&bytes),
+                starkit::image::ImageFormat::Png,
+            )
+            .into_dimensions()?;
+            ensure!(
+                (u64::from(dimensions.0), u64::from(dimensions.1)) == (width, height),
+                "Native plane PNG dimensions disagree"
+            );
+            encoded += png.len();
+            decoded += (width * height * 4) as usize;
+            images.push((png, z));
+        }
+        ensure!(
+            encoded <= 3 * 1024 * 1024,
+            "Native planes exceed wire limit"
+        );
+        let signature = value.to_string();
+        if generation == self.generation
+            && self
+                .slots
+                .get(view)
+                .is_some_and(|s| s.signature == signature)
+        {
+            return Ok(());
+        }
+        ensure!(
+            self.slots.contains_key(view) || self.slots.len() < 32,
+            "Too many native image views"
+        );
+        ensure!(
+            self.slots
+                .iter()
+                .filter(|(id, _)| id.as_str() != view)
+                .map(|(_, s)| s.encoded)
+                .sum::<usize>()
+                + encoded
+                <= 16 * 1024 * 1024,
+            "Native image cache is busy"
+        );
+        ensure!(
+            self.slots
+                .iter()
+                .filter(|(id, _)| id.as_str() != view)
+                .map(|(_, s)| s.decoded)
+                .sum::<usize>()
+                + decoded
+                <= 64 * 1024 * 1024,
+            "Native image textures are busy"
+        );
+        // All validation precedes output. Replace placements before retiring old
+        // IDs, under the same stdout lock used by the native text renderer.
+        write!(out, "\x1b[?2026h\x1b7\x1b[{};{}H", y + 1, x + 1)?;
+        if generation > self.generation {
+            self.clear(out)?;
+            self.generation = generation;
+        }
+        let mut ids = Vec::new();
+        for (png, z) in images {
+            self.next = self
+                .next
+                .checked_add(1)
+                .context("Native image IDs exhausted")?;
+            let id = self.next;
+            let chunks = png.as_bytes().chunks(4096);
+            let count = chunks.len();
+            for (n, chunk) in chunks.enumerate() {
+                let more = usize::from(n + 1 < count);
+                if n == 0 {
+                    write!(
+                        out,
+                        "\x1b_Ga=T,t=d,f=100,z={z},i={id},p=1,C=1,q=2,c={columns},r={rows},m={more};"
+                    )?;
+                } else {
+                    write!(out, "\x1b_Gm={more};")?;
+                }
+                out.write_all(chunk)?;
+                out.write_all(b"\x1b\\")?;
+            }
+            ids.push(id);
+        }
+        if let Some(old) = self.slots.remove(view) {
+            retire(&old.ids, out)?;
+        }
+        self.slots.insert(
+            view.into(),
+            Slot {
+                signature,
+                ids,
+                encoded,
+                decoded,
+            },
+        );
+        out.write_all(b"\x1b8\x1b[?2026l")?;
+        out.flush()?;
+        Ok(())
+    }
+}
